{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["db/**/*.ts", "worker/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "drizzle.config.ts"]
}
