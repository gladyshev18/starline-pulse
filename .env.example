NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters
DATABASE_URL=file:./data/app.db
RECEIPT_STORAGE_DIR=./data/refuel-receipts
SERVICE_DOCUMENT_STORAGE_DIR=./data/service-documents
SEED_USER_1_LOGIN=owner
SEED_USER_1_PASSWORD=replace-me
SEED_USER_1_DISPLAY_NAME=Владелец
SEED_USER_2_LOGIN=family
SEED_USER_2_PASSWORD=replace-me-too
SEED_USER_2_DISPLAY_NAME=Семья
STARLINE_MODE=fixture
STARLINE_FIXTURE_PATH=./fixtures/starline-device.example.json
STARLINE_APP_ID=
STARLINE_APP_SECRET=
STARLINE_LOGIN=
STARLINE_PASSWORD=
STARLINE_DEVICE_ID=
# off — импорт выключен, fixture — читать fixtures/receipt-mail.example.json, live — настоящий IMAP.
RECEIPTS_MAIL_MODE=off
RECEIPTS_MAIL_FIXTURE_PATH=./fixtures/receipt-mail.example.json
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
# Пароль приложения, а не основной пароль от почты.
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
# Адреса и домены отправителей чеков через запятую. Пустой список = ничего не импортируется.
IMAP_SENDER_ALLOWLIST=1-ofd.ru,ofd-ya-kassa.ru,ofd-ya.ru,platformaofd.ru,taxcom.ru,ofd.ru
IMAP_SINCE_DAYS=14
IMAP_MAX_MESSAGES=25
IMAP_POLL_MINUTES=15
IMAP_MARK_SEEN=false
# Необязательно: http://user:password@host:port или socks5://user:password@host:port
IMAP_PROXY_URL=

TELEGRAM_BOT_TOKEN=
# Необязательно: http://user:password@host:port или socks5://user:password@host:port
TELEGRAM_PROXY_URL=
# Только Telegram username через запятую. Chat ID бот определит после /start.
TELEGRAM_ALLOWED_USERNAMES=@gladyshev
