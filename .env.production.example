# Домен должен указывать A/AAAA-записью на сервер. Caddy автоматически получит TLS-сертификат.
APP_DOMAIN=pulse.example.com

# Сгенерируйте командой: openssl rand -base64 48
NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters

# В compose этот путь фиксирован и хранится в Docker volume app-data.
DATABASE_URL=file:/app/data/app.db

# Нужны только для первого запуска `docker compose run --rm seed`.
SEED_USER_1_LOGIN=owner
SEED_USER_1_PASSWORD=replace-with-a-strong-password
SEED_USER_1_DISPLAY_NAME=Владелец
SEED_USER_1_TELEGRAM_CHAT_ID=
SEED_USER_2_LOGIN=family
SEED_USER_2_PASSWORD=replace-with-another-strong-password
SEED_USER_2_DISPLAY_NAME=Семья
SEED_USER_2_TELEGRAM_CHAT_ID=

STARLINE_MODE=live
STARLINE_FIXTURE_PATH=./fixtures/starline-device.example.json
STARLINE_APP_ID=
STARLINE_APP_SECRET=
STARLINE_LOGIN=
STARLINE_PASSWORD=
STARLINE_DEVICE_ID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

